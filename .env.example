# ─────────────────────────────────────────────────────────────
# 환경변수 템플릿. 실제 값은 .env.local 에 넣는다 (git 미추적).
# NEXT_PUBLIC_ 접두사는 브라우저에 노출되는 공개값이라는 의미.
# ─────────────────────────────────────────────────────────────

# GA4 측정 ID (선택). 설정 시 페이지뷰/이벤트가 GA4로도 전송된다.
# 예: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Ads 전환 ID (선택 — 미설정 시 코드 기본값 AW-18389277474 사용).
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Ads 전환 라벨 (필수 — 전환을 실제로 기록하려면 반드시 설정).
# Google Ads > 도구 > 전환 > [전환 액션 생성] 후 발급되는 라벨.
# send_to 값 "AW-18389277474/XXXXXXXX" 에서 슬래시 뒤 부분만 입력.
# 미설정 시 CTA 클릭 전환 이벤트는 안전하게 건너뛴다(개발 중 콘솔 경고).
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# OpenAI Ads(ChatGPT 광고) Measurement Pixel ID (선택 — 미설정 시 픽셀을 아예 불러오지 않음).
# 이 사이트의 픽셀 ID: 7cATm8KzGCSsbvHaVn9PSo
# 설정하면 전체 페이지에 픽셀이 설치되고, /inquiry 상담 신청이 서버에 접수됐을 때만
# lead_created 전환이 1회 전송된다. 자세한 내용: docs/analytics/openai-ads-pixel.md
# ⚠️ 자동 고급 매칭(AAM) 켜짐 유지 결정 — SDK가 폼의 이메일·전화·이름(해시)과 지역을 OpenAI로 보낸다.
#    운영에 설정하기 전에 개인정보처리방침·동의 문구를 먼저 반영할 것.
NEXT_PUBLIC_OPENAI_PIXEL_ID=

# OpenAI 픽셀 debug 로그 강제 켜기 (선택). 개발 환경(next dev)에서는 자동으로 켜진다.
# 운영에서 콘솔로 동작을 확인해야 할 때만 잠시 true 로 둔다.
NEXT_PUBLIC_OPENAI_PIXEL_DEBUG=
